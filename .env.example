# =========================================================
# MODO LOCAL (funciona sin Azure; util para validar el repo)
# =========================================================
RETRIEVER_BACKEND=local
EMBEDDING_PROVIDER=hash
GENERATOR_PROVIDER=extractive
TOP_K=5
MIN_RELEVANCE=0.12
CHUNK_SIZE=900
CHUNK_OVERLAP=120

# =========================================================
# AZURE AI SEARCH (activar con RETRIEVER_BACKEND=azure)
# Cree un servicio Free y copie endpoint + admin key.
# =========================================================
AZURE_SEARCH_ENDPOINT=https://SU-SERVICIO.search.windows.net
AZURE_SEARCH_ADMIN_KEY=REEMPLAZAR
AZURE_SEARCH_INDEX=tsi-rag-lab
AZURE_SEARCH_API_VERSION=2025-09-01

# =========================================================
# EMBEDDINGS OPCIONALES
# hash: cero descargas, didactico y determinista
# sentence_transformers: mejor semantica; requiere: uv sync --extra semantic
# azure_openai: usa un deployment de embeddings si su cuenta lo permite
# =========================================================
# EMBEDDING_PROVIDER=sentence_transformers
SENTENCE_TRANSFORMER_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# EMBEDDING_PROVIDER=azure_openai
AZURE_OPENAI_ENDPOINT=https://SU-RECURSO.openai.azure.com
AZURE_OPENAI_API_KEY=REEMPLAZAR
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=REEMPLAZAR
AZURE_OPENAI_EMBEDDING_DIMENSIONS=1536

# =========================================================
# GENERADOR OPCIONAL
# extractive: fallback sin LLM; permite completar toda la infraestructura
# ollama: LLM local
# azure_openai: LLM Azure si el deployment esta disponible
# =========================================================
# GENERATOR_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# GENERATOR_PROVIDER=azure_openai
AZURE_OPENAI_CHAT_DEPLOYMENT=REEMPLAZAR

# =========================================================
# OBSERVABILIDAD BASICA
# =========================================================
QUERY_LOG_PATH=logs/queries.jsonl
